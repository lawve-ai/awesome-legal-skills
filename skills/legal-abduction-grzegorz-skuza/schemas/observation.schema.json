{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "la:schema/observation/v1",
  "title": "Observation",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "id": {
      "type": "string",
      "pattern": "^obs:[A-Za-z0-9._-]{1,128}$",
      "maxLength": 140
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^clm:[A-Za-z0-9._-]{1,128}$",
        "maxLength": 140
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "in_scope": {
      "type": "boolean"
    },
    "relevance_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "exclusion_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "required": [
    "case_id",
    "id",
    "description",
    "claim_ids",
    "in_scope"
  ],
  "additionalProperties": false
}
