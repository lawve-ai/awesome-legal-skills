{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "la:schema/profile/v1",
  "title": "Case profile",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "lang": {
      "enum": [
        "pl",
        "en"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "time_window": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "corpus_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "perspectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^per:[A-Za-z0-9._-]{1,128}$",
            "maxLength": 140
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "role": {
            "enum": [
              "party",
              "subject",
              "organization",
              "third_party"
            ]
          },
          "conduct_in_scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "role",
          "conduct_in_scope"
        ],
        "additionalProperties": false
      }
    },
    "deployment_context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "model_processing": {
      "enum": [
        "allowed",
        "forbidden"
      ]
    },
    "host_level": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "deployer_ack": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "by"
      ],
      "additionalProperties": false
    },
    "report_profile": {
      "enum": [
        "working",
        "exhibit"
      ]
    }
  },
  "required": [
    "lang",
    "question",
    "time_window",
    "corpus_scope",
    "jurisdiction",
    "purpose",
    "perspectives",
    "deployment_context",
    "model_processing"
  ],
  "additionalProperties": false
}
